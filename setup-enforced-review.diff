+    )
+    overall_progress = (mastered_topics / total_topics * 100) if total_topics else 0.0
+    overall_exposure = (attempted_topics / total_topics * 100) if total_topics else 0.0
+    overall_risk_tier = _aggregate_risk_tier(risk_tiers)
+
+    return {
+        "student": {
