+              <div className="h-1.5 w-full rounded-full bg-white/5 overflow-hidden">
+                <div
+                  className={`h-full rounded-full ${item.color}`}
+                  style={{ width: `${pct}%` }}
+                />
+              </div>
+            </div>
+          );
