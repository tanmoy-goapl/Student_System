+        flushBlock();
+        currentType = "title";
+        const rest = line.replace("[TITLE]", "").trim();
+        if (rest) currentContent.push(rest);
+      } else if (line.startsWith("[CONTENT]")) {
+        flushBlock();
+        currentType = "content";
