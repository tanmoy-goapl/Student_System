+                chunk_lower = chunk.lower()
+                if topic_words and not any(w in chunk_lower for w in topic_words):
+                    logger.info(f"[Context] Discarded irrelevant chunk for topic='{topic}'")
+                    return ""
+                return chunk
+    except Exception as e:
