+            />
+          </div>
+
+          <div>
+            <div className="mb-2 flex items-center justify-between gap-2">
+              <label className="text-xs font-semibold uppercase tracking-wide text-slate-400">
+                Password
+              </label>
+              <button
+                type="button"
+                className="text-xs font-medium text-sky-400 hover:text-sky-300"
