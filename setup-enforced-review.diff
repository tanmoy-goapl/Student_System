+// ── Types ───────────────────────────────────────────────────
+interface ClassInfo { id: number; name: string; code: string; course_code: string }
+interface KPI {
+  avgScore: number;
+  engagement: number;
+  atRiskCount: number;
+  weakTopicCount: number;
+  scoreDelta: number;
+  activeStudents?: number;
