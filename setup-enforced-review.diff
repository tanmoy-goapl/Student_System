+    
+    unstarted = [t for t in sorted_all if t["days_since_practice"] >= 30 and t["status"] == "NOT_STARTED"]
+    learn_topic = unstarted[0] if unstarted else (sorted_all[0] if sorted_all else None)
+
+    actions = []
+    
+    # 1. Continue Practice
+    if focus_practice:
