+}
+
+interface LivePerformanceProps {
+  accuracy: number;
+  avgSpeed: string;
+  streak: number;
+  pointsEarned: number;
+  trendData?: number[];
+}
+
+const colorMap = {
+  yellow: "text-yellow-400",
+  cyan: "text-cyan-400",
+  purple: "text-purple-400",
+  blue: "text-blue-400",
+};
+
+const borderMap = {
