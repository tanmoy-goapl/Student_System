+            health = "Green"
+        elif avg_unit_acc >= 60:
+            health = "Yellow"
+        else:
+            health = "Red"
+
+        unit_analytics.append({
+            "name": unit_name,
+            "accuracy": avg_unit_acc,
+            "completion": avg_unit_comp,
+            "health": health,
+        })
+
+    # 4. Recent Activity Feed
+    activity_feed = []
+    recent_quizzes = db.query(QuizHistory).filter(
