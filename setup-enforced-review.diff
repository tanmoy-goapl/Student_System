+
+      {/* Metrics Grid */}
+      <div className="grid grid-cols-2 gap-2 mb-4">
+        {metrics.map((metric, idx) => (
+          <div
+            key={idx}
+            className={`p-3 rounded-lg bg-white/[0.02] border ${borderMap[metric.color]} backdrop-blur-sm hover:bg-white/[0.05] transition-colors`}
