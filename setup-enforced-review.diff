+                        <span className={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${rm.status === 'Completed' ? 'text-green-400 bg-green-400/10' : 'text-amber-400 bg-amber-400/10'}`}>
+                          {rm.status}
