+                {isAddingRevision ? 'Adding...' : isRevisionAdded ? 'In Revision' : 'Add to Revision'}
+              </button>
+            )}
+          </div>
+          {revisionError && (
+            <p className="mt-2 text-[10px] text-rose-300" role="status">
+              {revisionError}
+            </p>
+          )}
+        </div>
+      </div>
+
+    </div>
+  );
+}
