+
+        from database import SessionLocal
+        local_db = SessionLocal()
+        try:
+            existing = local_db.query(LearningContent).filter(
+                LearningContent.student_id == student_id,
+                LearningContent.subject == subject,
+                LearningContent.topic == topic
+            ).first()
+            if existing:
