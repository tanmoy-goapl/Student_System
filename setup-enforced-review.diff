+const buildHomeRecommendation = (dashboard: DashboardData): HomeRecommendation => {
+  const focusTopic = dashboard.weakTopics[0];
+  const scoreDelta = Number(dashboard.kpi.scoreDelta || 0);
+
+  if (focusTopic) {
