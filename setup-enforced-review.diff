+    """Evaluate a small arithmetic expression without invoking Python eval."""
+    if depth > 20:
+        raise ValueError("expression too deep")
+    if isinstance(node, ast.Expression):
+        return _evaluate_basic_arithmetic(node.body, depth + 1)
