+
+    perf = db.query(TopicPerformance).filter(
+        TopicPerformance.student_id == student_id,
+        TopicPerformance.topic == topic_name
+    ).first()
+    
+    metrics = calculate_topic_metrics(perf)
+    return {
+        "sessions": metrics["sessions"],
