+                      </div>
+                      <button 
+                        onClick={(e) => handleDelete(e, rm.id)}
+                        className="text-slate-500 hover:text-red-400 transition-colors p-1 rounded hover:bg-red-400/10"
+                        title="Delete Roadmap"
+                      >
+                        <Trash2 className="w-4 h-4" />
