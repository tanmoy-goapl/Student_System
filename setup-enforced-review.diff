+
+        <div className="min-h-0 overflow-y-auto px-5 py-4 sm:px-6 sm:py-5">
+          <form onSubmit={handleSubmit} className="space-y-4">
+            <section className="rounded-2xl border border-indigo-400/15 bg-indigo-500/[0.07] p-3.5 sm:p-4">
