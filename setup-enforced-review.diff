+const buildTeachingInsights = (dashboard: DashboardData): TeachingInsight[] => {
+  const scoreDelta = Number(dashboard.kpi.scoreDelta || 0);
+  const totalStudents = Math.max(0, dashboard.totalStudents || 0);
