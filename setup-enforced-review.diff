+  code: ({node, className, children, ...props}: any) => {
+    const match = /language-(\w+)/.exec(className || '');
+    return match ? (
+      <pre className="bg-[#0c1020] border border-white/10 p-3.5 rounded-xl font-mono text-[10px] text-blue-200 overflow-x-auto my-3">
