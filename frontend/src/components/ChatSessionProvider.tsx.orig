"use client";

import {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";

export type ChatMessage = {
  role: string;
  content: string;
  created_at?: string | null;
  session_id?: string | null;
  intent?: string;
  roadmap_metadata?: { title: string; duration: string; weeks: number; tasks: number };
  suggest_roadmap?: boolean;
  options?: string[];
};

export type ChatUser = {
  id: number;
  role: string;
  name: string;
} | null;

type ChatSessionContextValue = {
  user: ChatUser;
  question: string;
  setQuestion: (question: string) => void;
  history: ChatMessage[];
  loading: boolean;
  streamStatus: string;
  isStreaming: boolean;
  error: string;
  setError: (error: string) => void;
  activeSessionId: string | null;
  handleAsk: () => Promise<void>;
  handleStop: () => void;
  handleNewChat: () => void;
  handleSelectSession: (sessionId: string) => Promise<void>;
  handleSelectHistoryEntry: (item: { content: string; created_at?: string | null }) => Promise<void>;
  appendAssistantMessage: (content: string) => void;
};

const ChatSessionContext = createContext<ChatSessionContextValue | null>(null);

type Props = {
  userId: string | null;
  role: string | null;
  userName: string | null;
  children: React.ReactNode;
};

function getChatUser(userId: string | null, role: string | null, userName: string | null): ChatUser {
  const id = Number.parseInt(userId || "0", 10);
  if (!id || !role) return null;

  const name =
    userName ||
    (typeof window !== "undefined" ? localStorage.getItem("user_email") || "" : "")
      .split("@")[0]
      .replace(/[._]/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase()) ||
    "User";

  return { id, role, name };
}

export default function ChatSessionProvider({ userId, role, userName, children }: Props) {
  const user = useMemo(() => getChatUser(userId, role, userName), [userId, role, userName]);
  const identity = user ? `${user.role}:${user.id}` : null;

  const [question, setQuestionState] = useState("");
  const [history, setHistory] = useState<ChatMessage[]>([]);
  const [loading, setLoading] = useState(false);
  const [streamStatus, setStreamStatus] = useState("");
  const [isStreaming, setIsStreaming] = useState(false);
  const [error, setError] = useState("");
  const [resetNext, setResetNext] = useState(false);
  const [activeSessionId, setActiveSessionId] = useState<string | null>(null);

  const identityRef = useRef<string | null | undefined>(undefined);
  const loadVersionRef = useRef(0);
  const requestVersionRef = useRef(0);
  const abortControllerRef = useRef<AbortController | null>(null);
  const targetChatTextRef = useRef("");
  const chatTypewriterIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const clearTypewriter = useCallback(() => {
    if (chatTypewriterIntervalRef.current) {
      clearInterval(chatTypewriterIntervalRef.current);
      chatTypewriterIntervalRef.current = null;
    }
  }, []);

  const setQuestion = useCallback((value: string) => {
    setQuestionState(value);
    if (typeof window !== "undefined") {
      if (value) localStorage.setItem("chat_input", value);
      else localStorage.removeItem("chat_input");
    }
  }, []);

  const resetLocalState = useCallback(() => {
    loadVersionRef.current += 1;
    requestVersionRef.current += 1;
    abortControllerRef.current?.abort();
    abortControllerRef.current = null;
    clearTypewriter();
    targetChatTextRef.current = "";
    setHistory([]);
    setQuestion("");
    setLoading(false);
    setStreamStatus("");
    setIsStreaming(false);
    setError("");
    setResetNext(false);
    setActiveSessionId(null);
  }, [clearTypewriter, setQuestion]);

  const loadLatestSession = useCallback(async (studentId: number, expectedIdentity: string) => {
    const loadVersion = ++loadVersionRef.current;
    try {
      setLoading(true);
      const res = await fetch(`/api/chat/history?student_id=${studentId}`, {
        cache: "no-store",
      });
      if (!res.ok) return;

      const data = (await res.json()) as ChatMessage[];
      if (
        loadVersion !== loadVersionRef.current ||
        identityRef.current !== expectedIdentity ||
        requestVersionRef.current !== 0 && abortControllerRef.current
      ) {
        return;
      }

      setHistory(Array.isArray(data) ? data : []);
      setActiveSessionId(data?.find((message) => message.session_id)?.session_id || null);
      setResetNext(false);
    } catch (err) {
      console.error("Failed to restore latest chat session:", err);
    } finally {
      if (loadVersion === loadVersionRef.current) setLoading(false);
    }
  }, []);

  // AppLayout stays mounted while the user changes routes. Only a real
  // identity change (login, logout, or switching accounts) clears the chat.
  useEffect(() => {
    if (identityRef.current === identity) return;
    identityRef.current = identity;

    resetLocalState();
    if (user) {
      const savedInput = localStorage.getItem("chat_input");
      if (savedInput) setQuestionState(savedInput);
      void loadLatestSession(user.id, identity as string);
    }
  }, [identity, loadLatestSession, resetLocalState, user]);

  // Handle New Chat from the history sidebar even when ChatPage is not mounted.
  useEffect(() => {
    const handleNewChatEvent = () => {
      resetLocalState();
      setResetNext(true);
    };
    window.addEventListener("new-chat", handleNewChatEvent);
    return () => window.removeEventListener("new-chat", handleNewChatEvent);
  }, [resetLocalState]);

  // A full document unload is the one case where the route-stable provider is
  // also destroyed. Abort deliberately so the backend can persist partial work.
  useEffect(() => {
    return () => {
      abortControllerRef.current?.abort();
      clearTypewriter();
    };
  }, [clearTypewriter]);

  const handleAsk = useCallback(async () => {
    const q = question.trim();
    if (!q || !user?.id || isStreaming) return;

    const requestVersion = ++requestVersionRef.current;
    const requestReset = resetNext;
    loadVersionRef.current += 1;
    setError("");
    setHistory((prev) => [...prev, { role: "user", content: q }]);
    setQuestion("");
    setLoading(true);
    setIsStreaming(true);

    try {
      const controller = new AbortController();
      abortControllerRef.current = controller;

      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          student_id: user.id,
          question: q,
          role: user.role,
          reset: requestReset,
          session_id: activeSessionId || undefined,
        }),
        signal: controller.signal,
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data?.detail || `Error ${res.status}`);
      }

      setLoading(false);
      const reader = res.body?.getReader();
      if (!reader) throw new Error("No response stream available");

      setHistory((prev) => [...prev, { role: "assistant", content: "" }]);
      targetChatTextRef.current = "";
      clearTypewriter();

      let currentTypewriterLength = 0;
      chatTypewriterIntervalRef.current = setInterval(() => {
        if (currentTypewriterLength < targetChatTextRef.current.length) {
          const diff = targetChatTextRef.current.length - currentTypewriterLength;
          const step = diff > 150 ? 10 : diff > 40 ? 4 : diff > 10 ? 2 : 1;
          currentTypewriterLength += step;
          const textChunk = targetChatTextRef.current.slice(0, currentTypewriterLength);
          setHistory((prev) => {
            const copy = [...prev];
            if (copy.length > 0 && copy[copy.length - 1].role === "assistant") {
              copy[copy.length - 1] = { ...copy[copy.length - 1], content: textChunk };
            }
            return copy;
          });
        }
      }, 20);

      const decoder = new TextDecoder();
      let done = false;
      let finalIntent = "";
      let finalMetadata: ChatMessage["roadmap_metadata"] = undefined;
      let finalSuggest = false;
      let finalSessionId = "";
      let finalOptions: string[] | undefined;
      let buffer = "";

      while (!done) {
        const { value, done: doneReading } = await reader.read();
        done = doneReading;
        if (!value) continue;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split("\n");
        buffer = lines.pop() || "";

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed) continue;
          try {
            const parsed = JSON.parse(trimmed);
            if (parsed.error) throw new Error(parsed.error);
            if (parsed.status !== undefined) setStreamStatus(parsed.status);
            if (parsed.content) {
              setStreamStatus("");
              targetChatTextRef.current += parsed.content;
            }
            if (parsed.intent) finalIntent = parsed.intent;
            if (parsed.roadmap_metadata) finalMetadata = parsed.roadmap_metadata;
            if (parsed.suggest_roadmap) finalSuggest = true;
            if (parsed.options) finalOptions = parsed.options;
            if (parsed.session_id) finalSessionId = parsed.session_id;
          } catch (err) {
            console.error("Error parsing stream line:", err);
          }
        }
      }

      clearTypewriter();
      if (requestVersion !== requestVersionRef.current) return;
      setHistory((prev) => {
        const copy = [...prev];
        if (copy.length > 0 && copy[copy.length - 1].role === "assistant") {
          copy[copy.length - 1] = {
            ...copy[copy.length - 1],
            content: targetChatTextRef.current,
            intent: finalIntent,
            roadmap_metadata: finalMetadata,
            suggest_roadmap: finalSuggest,
            options: finalOptions,
          };
        }
        return copy;
      });

      if (finalSessionId) setActiveSessionId(finalSessionId);
      if (!targetChatTextRef.current && !finalMetadata) {
        setError("No response received. Please try again.");
        setHistory((prev) => prev.slice(0, -1));
      }
    } catch (err: any) {
      if (requestVersion !== requestVersionRef.current) return;
      if (err?.name === "AbortError") {
        setStreamStatus("");
        // The user message is committed before streaming starts. Reloading
        // after a stop/disconnect recovers its session_id and any saved reply.
        if (user) await loadLatestSession(user.id, identity as string);
      } else {
        setError(err?.message || "Failed to get answer. Please try again.");
        setHistory((prev) => prev.slice(0, -1));
      }
    } finally {
      if (requestVersion !== requestVersionRef.current) return;
      clearTypewriter();
      setLoading(false);
      setStreamStatus("");
      setIsStreaming(false);
      abortControllerRef.current = null;
      setResetNext(false);
    }
  }, [
    activeSessionId,
    clearTypewriter,
    identity,
    isStreaming,
    loadLatestSession,
    question,
    resetNext,
    setQuestion,
    user,
  ]);

  const handleStop = useCallback(() => {
    abortControllerRef.current?.abort();
  }, []);

  const handleNewChat = useCallback(() => {
    resetLocalState();
    setResetNext(true);
  }, [resetLocalState]);

  const handleSelectSession = useCallback(async (sessionId: string) => {
    if (!user?.id) return;
    loadVersionRef.current += 1;
    try {
      setLoading(true);
      const res = await fetch(`/api/chat/history?student_id=${user.id}&session_id=${sessionId}`, {
        cache: "no-store",
      });
      if (!res.ok) return;
      const data = (await res.json()) as ChatMessage[];
      if (identityRef.current !== identity) return;
      setHistory(Array.isArray(data) ? data : []);
      setActiveSessionId(sessionId);
      setResetNext(false);
      setError("");
    } catch (err) {
      console.error("Failed to load session history:", err);
    } finally {
      setLoading(false);
    }
  }, [identity, user]);

  const handleSelectHistoryEntry = useCallback(async (item: { content: string; created_at?: string | null }) => {
    if (!user?.id) return;
    try {
      const res = await fetch(`/api/chat/history?student_id=${user.id}`, { cache: "no-store" });
      if (!res.ok) return;
      const data = (await res.json()) as ChatMessage[];

      let idx = item.created_at
        ? data.findIndex((message) => message.role === "user" && message.created_at === item.created_at)
        : -1;
      if (idx === -1) {
        for (let i = data.length - 1; i >= 0; i -= 1) {
          if (data[i].role === "user" && data[i].content === item.content) {
            idx = i;
            break;
          }
        }
      }

      if (idx === -1) {
        setHistory(data);
        setActiveSessionId(data?.find((message) => message.session_id)?.session_id || null);
        return;
      }

      let end = data.length;
      for (let i = idx + 1; i < data.length; i += 1) {
        if (data[i].role === "user") {
          end = i;
          break;
        }
      }
      setHistory(data.slice(idx, end));
      setActiveSessionId(data[idx]?.session_id || null);
    } catch {
      // History selection is best-effort; the current session remains visible.
    }
  }, [user]);

  const appendAssistantMessage = useCallback((content: string) => {
    setHistory((prev) => [...prev, { role: "assistant", content }]);
  }, []);

  const value = useMemo<ChatSessionContextValue>(() => ({
    user,
    question,
    setQuestion,
    history,
    loading,
    streamStatus,
    isStreaming,
    error,
    setError,
    activeSessionId,
    handleAsk,
    handleStop,
    handleNewChat,
    handleSelectSession,
    handleSelectHistoryEntry,
    appendAssistantMessage,
  }), [
    activeSessionId,
    appendAssistantMessage,
    error,
    handleAsk,
    handleNewChat,
    handleSelectHistoryEntry,
    handleSelectSession,
    handleStop,
    history,
    isStreaming,
    loading,
    question,
    setQuestion,
    streamStatus,
    user,
  ]);

  return <ChatSessionContext.Provider value={value}>{children}</ChatSessionContext.Provider>;
}

export function useChatSession() {
  const context = useContext(ChatSessionContext);
  if (!context) {
    throw new Error("useChatSession must be used inside ChatSessionProvider");
  }
  return context;
}
